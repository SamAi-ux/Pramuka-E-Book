rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVE HELPERS ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'arifwir6@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
      );
    }

    function isValidRank(rank) {
      return rank is string && rank in ['SIAGA', 'PENGGALANG', 'PENEGAK', 'PANDEGA', 'PEMBINA', 'BINA_DAMPING'];
    }

    function hasValidTimestamps(data) {
      return data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- SCHEMA VALIDATION HELPERS ---
    function isValidUserAccount(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role is string && (data.role == 'anggota' || data.role == 'admin') &&
        hasValidTimestamps(data);
    }

    function isValidUserScoutProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.school is string && data.school.size() >= 1 && data.school.size() <= 160 &&
        data.gudep is string && data.gudep.size() >= 1 && data.gudep.size() <= 80 &&
        isValidRank(data.rank) &&
        data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 40 &&
        data.avatarId is int && data.avatarId >= 1 && data.avatarId <= 20 &&
        (!('customPhotoPath' in data) || (data.customPhotoPath is string && data.customPhotoPath.size() <= 500)) &&
        data.npa is string && data.npa.size() >= 1 && data.npa.size() <= 60 &&
        data.skuProgress is int && data.skuProgress >= 0 && data.skuProgress <= 100 &&
        data.tkkCount is int && data.tkkCount >= 0 && data.tkkCount <= 1000 &&
        data.isGaruda is bool &&
        hasValidTimestamps(data);
    }

    function isValidActivityRegistration(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.activityId is string && data.activityId.size() >= 1 && data.activityId.size() <= 128 &&
        data.registered is bool &&
        hasValidTimestamps(data);
    }

    function isValidAdminRole(data) {
      return data.adminUid is string && data.adminUid.size() >= 1 && data.adminUid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.role is string && data.role == 'admin' &&
        data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128 &&
        data.active is bool &&
        hasValidTimestamps(data);
    }

    function isValidInstitutionProfile(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.gudep is string && data.gudep.size() >= 1 && data.gudep.size() <= 80 &&
        data.logoPath is string && data.logoPath.size() <= 500 &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        hasValidTimestamps(data);
    }

    function isValidScoutMaterial(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.summary is string && data.summary.size() <= 500 &&
        data.content is string && data.content.size() <= 10000 &&
        data.details is list && data.details.size() <= 50 &&
        data.iconKey is string && data.iconKey.size() >= 1 && data.iconKey.size() <= 40 &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        hasValidTimestamps(data);
    }

    function isValidSemesterSyllabus(data) {
      return data.semester is string && data.semester.size() >= 1 && data.semester.size() <= 80 &&
        isValidRank(data.rank) &&
        data.programTitle is string && data.programTitle.size() >= 1 && data.programTitle.size() <= 200 &&
        data.weekRange is string && data.weekRange.size() >= 1 && data.weekRange.size() <= 80 &&
        data.competencyTarget is string && data.competencyTarget.size() >= 1 && data.competencyTarget.size() <= 1000 &&
        data.method is string && data.method.size() >= 1 && data.method.size() <= 200 &&
        data.status is string && data.status.size() >= 1 && data.status.size() <= 40 &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        hasValidTimestamps(data);
    }

    function isValidScoutActivity(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.date is string && data.date.size() >= 1 && data.date.size() <= 80 &&
        data.time is string && data.time.size() >= 1 && data.time.size() <= 80 &&
        data.location is string && data.location.size() >= 1 && data.location.size() <= 200 &&
        data.leader is string && data.leader.size() >= 1 && data.leader.size() <= 120 &&
        data.quota is int && data.quota >= 1 && data.quota <= 5000 &&
        data.registeredCount is int && data.registeredCount >= 0 && data.registeredCount <= 5000 &&
        data.status is string && data.status.size() >= 1 && data.status.size() <= 40 &&
        data.description is string && data.description.size() <= 2000 &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        hasValidTimestamps(data);
    }

    function isValidScoutAnnouncement(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.content is string && data.content.size() <= 4000 &&
        data.date is string && data.date.size() >= 1 && data.date.size() <= 80 &&
        data.priority is string && data.priority.size() >= 1 && data.priority.size() <= 40 &&
        data.author is string && data.author.size() >= 1 && data.author.size() <= 120 &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        hasValidTimestamps(data);
    }

    function isValidScoutMember(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.school is string && data.school.size() >= 1 && data.school.size() <= 160 &&
        data.gudep is string && data.gudep.size() >= 1 && data.gudep.size() <= 80 &&
        isValidRank(data.rank) &&
        data.skuLevel is string && data.skuLevel.size() >= 1 && data.skuLevel.size() <= 100 &&
        data.joinDate is string && data.joinDate.size() >= 1 && data.joinDate.size() <= 60 &&
        data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 40 &&
        data.verified is bool &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        hasValidTimestamps(data);
    }

    // --- COLLECTION: /users/{userId} ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (isBootstrappedAdmin() || resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        incoming().keys().hasAll(['userId', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        isValidUserAccount(incoming()) &&
        (
          (request.auth.uid == userId && incoming().userId == request.auth.uid && incoming().role == 'anggota') ||
          isAdmin()
        );

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserAccount(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          (
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt'])
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'role', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();

      // Personal Scouting Profile (PII strictly owner or admin)
      match /profile/{docId} {
        allow get, list: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          docId == 'main' &&
          incoming().keys().hasAll(['userId', 'name', 'school', 'gudep', 'rank', 'phone', 'avatarId', 'npa', 'skuProgress', 'tkkCount', 'isGaruda', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['userId', 'name', 'school', 'gudep', 'rank', 'phone', 'avatarId', 'customPhotoPath', 'npa', 'skuProgress', 'tkkCount', 'isGaruda', 'createdAt', 'updatedAt']) &&
          incoming().userId == userId &&
          (request.auth.uid == userId || isAdmin()) &&
          isValidUserScoutProfile(incoming());

        allow update: if isSignedIn() &&
          isValidId(userId) &&
          docId == 'main' &&
          (request.auth.uid == userId || isAdmin()) &&
          isValidUserScoutProfile(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'school', 'gudep', 'rank', 'phone', 'avatarId',
            'customPhotoPath', 'npa', 'skuProgress', 'tkkCount', 'isGaruda', 'updatedAt'
          ]);

        allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      }

      // Per-user Activity Registrations
      match /activityRegistrations/{activityId} {
        allow get, list: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(activityId) &&
          incoming().keys().hasAll(['userId', 'activityId', 'registered', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['userId', 'activityId', 'registered', 'createdAt', 'updatedAt']) &&
          incoming().userId == userId &&
          incoming().activityId == activityId &&
          (request.auth.uid == userId || isAdmin()) &&
          isValidActivityRegistration(incoming());

        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(activityId) &&
          (request.auth.uid == userId || isAdmin()) &&
          isValidActivityRegistration(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().activityId == existing().activityId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['registered', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      }
    }

    // --- COLLECTION: /admins/{adminUid} ---
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());

      allow list: if isSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.grantedBy == request.auth.uid ||
        resource.data.adminUid == request.auth.uid
      );

      allow create: if isValidId(adminUid) &&
        incoming().keys().hasAll(['adminUid', 'email', 'role', 'grantedBy', 'active', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['adminUid', 'email', 'role', 'grantedBy', 'active', 'createdAt', 'updatedAt']) &&
        incoming().adminUid == adminUid &&
        incoming().grantedBy == request.auth.uid &&
        isValidAdminRole(incoming()) &&
        isAdmin();

      allow update: if isValidId(adminUid) &&
        isValidAdminRole(incoming()) &&
        incoming().adminUid == existing().adminUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role', 'grantedBy', 'active', 'updatedAt']) &&
        isAdmin();

      allow delete: if isValidId(adminUid) && isAdmin();
    }

    // --- COLLECTION: /pangkalan/{configId} (Shared Institution Config) ---
    match /pangkalan/{configId} {
      allow get, list: if isSignedIn();

      allow create: if isAdmin() &&
        configId == 'institution' &&
        incoming().keys().hasAll(['name', 'gudep', 'logoPath', 'updatedBy', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['name', 'gudep', 'logoPath', 'updatedBy', 'createdAt', 'updatedAt']) &&
        incoming().updatedBy == request.auth.uid &&
        isValidInstitutionProfile(incoming());

      allow update: if isAdmin() &&
        configId == 'institution' &&
        isValidInstitutionProfile(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedBy == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'gudep', 'logoPath', 'updatedBy', 'updatedAt']);

      allow delete: if isAdmin() && configId == 'institution';
    }

    // --- COLLECTION: /materials/{materialId} ---
    match /materials/{materialId} {
      allow get, list: if isSignedIn();

      allow create: if isAdmin() &&
        isValidId(materialId) &&
        incoming().keys().hasAll(['title', 'category', 'summary', 'content', 'details', 'iconKey', 'updatedBy', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['title', 'category', 'summary', 'content', 'details', 'iconKey', 'updatedBy', 'createdAt', 'updatedAt']) &&
        incoming().updatedBy == request.auth.uid &&
        isValidScoutMaterial(incoming());

      allow update: if isAdmin() &&
        isValidId(materialId) &&
        isValidScoutMaterial(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedBy == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'summary', 'content', 'details', 'iconKey', 'updatedBy', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(materialId);
    }

    // --- COLLECTION: /syllabi/{syllabusId} ---
    match /syllabi/{syllabusId} {
      allow get, list: if isSignedIn();

      allow create: if isAdmin() &&
        isValidId(syllabusId) &&
        incoming().keys().hasAll(['semester', 'rank', 'programTitle', 'weekRange', 'competencyTarget', 'method', 'status', 'updatedBy', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['semester', 'rank', 'programTitle', 'weekRange', 'competencyTarget', 'method', 'status', 'updatedBy', 'createdAt', 'updatedAt']) &&
        incoming().updatedBy == request.auth.uid &&
        isValidSemesterSyllabus(incoming());

      allow update: if isAdmin() &&
        isValidId(syllabusId) &&
        isValidSemesterSyllabus(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedBy == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['semester', 'rank', 'programTitle', 'weekRange', 'competencyTarget', 'method', 'status', 'updatedBy', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(syllabusId);
    }

    // --- COLLECTION: /activities/{activityId} ---
    match /activities/{activityId} {
      allow get, list: if isSignedIn();

      allow create: if isAdmin() &&
        isValidId(activityId) &&
        incoming().keys().hasAll(['title', 'category', 'date', 'time', 'location', 'leader', 'quota', 'registeredCount', 'status', 'description', 'updatedBy', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['title', 'category', 'date', 'time', 'location', 'leader', 'quota', 'registeredCount', 'status', 'description', 'updatedBy', 'createdAt', 'updatedAt']) &&
        incoming().updatedBy == request.auth.uid &&
        isValidScoutActivity(incoming());

      allow update: if isAdmin() &&
        isValidId(activityId) &&
        isValidScoutActivity(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedBy == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'date', 'time', 'location', 'leader', 'quota', 'registeredCount', 'status', 'description', 'updatedBy', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(activityId);
    }

    // --- COLLECTION: /announcements/{announcementId} ---
    match /announcements/{announcementId} {
      allow get, list: if isSignedIn();

      allow create: if isAdmin() &&
        isValidId(announcementId) &&
        incoming().keys().hasAll(['title', 'content', 'date', 'priority', 'author', 'updatedBy', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['title', 'content', 'date', 'priority', 'author', 'updatedBy', 'createdAt', 'updatedAt']) &&
        incoming().updatedBy == request.auth.uid &&
        isValidScoutAnnouncement(incoming());

      allow update: if isAdmin() &&
        isValidId(announcementId) &&
        isValidScoutAnnouncement(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedBy == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'date', 'priority', 'author', 'updatedBy', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(announcementId);
    }

    // --- COLLECTION: /members/{memberId} (PII restricted to verified admins) ---
    match /members/{memberId} {
      allow get, list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(memberId) &&
        incoming().keys().hasAll(['name', 'school', 'gudep', 'rank', 'skuLevel', 'joinDate', 'phone', 'verified', 'createdBy', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['name', 'school', 'gudep', 'rank', 'skuLevel', 'joinDate', 'phone', 'verified', 'createdBy', 'createdAt', 'updatedAt']) &&
        incoming().createdBy == request.auth.uid &&
        isValidScoutMember(incoming());

      allow update: if isAdmin() &&
        isValidId(memberId) &&
        isValidScoutMember(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().createdBy == existing().createdBy &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'school', 'gudep', 'rank', 'skuLevel', 'joinDate', 'phone', 'verified', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(memberId);
    }
  }
}
